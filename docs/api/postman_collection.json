{
  "info": {
    "_postman_id": "a548234a-18e4-4d8e-b570-3444747a8292",
    "name": "HRIS System E2E API Testing (Gateway)",
    "description": "Koleksi API Postman Terpadu untuk menguji seluruh sistem HRIS melalui API Gateway hris-be-orchestrator (Port 4000). Mengandung skenario login, user management, employee CRUD, reporting line matrix validation, cycle detection, dan RBAC checks.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Authentication (Auth Service via Gateway)",
      "item": [
        {
          "name": "Login User (Success)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Verify token structure and envelope\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"success\");",
                  "    pm.expect(jsonData.data.access_token).to.be.a('string');",
                  "    pm.expect(jsonData.data.token_type).to.eql(\"Bearer\");",
                  "});"
                ],
                "type": "javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{testEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/login",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create User Account (Superadmin Only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 or 409 (If Email Exists)\", function () {",
                  "    var code = pm.response.code;",
                  "    pm.expect(code === 201 || code === 409).to.be.true;",
                  "});"
                ],
                "type": "javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{superadminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"citra.staff@majumundur.com\",\n  \"password\": \"securepassword123\",\n  \"role\": \"employee\",\n  \"emp_id\": 1000002\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{gatewayUrl}}/auth/users",
              "host": [
                "{{gatewayUrl}}"
              ],
              "path": [
                "auth",
                "users"
              ]
            }
          },
          "response": []
        }
      ]
    },
